# Choose exactly one server-side provider. Default is balldontlie.
NBA_DATA_PROVIDER=balldontlie

# BALLDONTLIE: used when NBA_DATA_PROVIDER=balldontlie.
BALLDONTLIE_API_KEY=

# API-NBA: used when NBA_DATA_PROVIDER=api-nba.
# Obtain at https://dashboard.api-football.com/
API_NBA_KEY=
# "free" (100 requests/day) or "pro" (paid plan, 7500 requests/day).
API_NBA_PLAN=free

# Never prefix any credential with NEXT_PUBLIC_.
