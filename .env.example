# Free default: swar/nba_api (https://github.com/swar/nba_api)
# No paid API subscription or NBA API key is needed.
NBA_DATA_PROVIDER=nba-api

# Local bridge URL, for running Node.js and Python separately.
# With Docker Compose the bridge URL and provider are configured automatically.
NBA_API_BRIDGE_URL=http://127.0.0.1:8765
# Set this to a PRIVATE random token and use the same value in both services.
NBA_API_BRIDGE_TOKEN=

# Optional legacy providers — NEVER used unless explicitly selected.
# Paid plans are not required or enabled by default.
# NBA_DATA_PROVIDER=balldontlie
# BALLDONTLIE_API_KEY=
# NBA_DATA_PROVIDER=api-nba
# API_NBA_KEY=
# API_NBA_PLAN=free

# NEVER expose credentials as NEXT_PUBLIC_*.
