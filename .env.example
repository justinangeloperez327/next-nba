# Choose exactly one provider (server-side).
# Existing default is balldontlie; Docker Compose selects nba-api automatically.
NBA_DATA_PROVIDER=balldontlie
BALLDONTLIE_API_KEY=

# Commercial API-NBA (api-sports.io) — DIFFERENT from swar/nba_api:
API_NBA_KEY=
API_NBA_PLAN=free

# swar/nba_api Python bridge (no provider key; private bridge auth required):
# NBA_DATA_PROVIDER=nba-api
NBA_API_BRIDGE_URL=http://127.0.0.1:8765
NBA_API_BRIDGE_TOKEN=

# NEVER prefix these variables with NEXT_PUBLIC_.
